# .env.example
# Copy file ini menjadi .env jika Anda memerlukan environment variables

# Contoh: Jika nanti ingin menambahkan Google Analytics
# VITE_GA_TRACKING_ID=UA-XXXXXXXXX-X

# Contoh: Jika ingin menambahkan API untuk backend
# VITE_API_URL=https://api.example.com

# Note: Variabel environment di Vite harus dimulai dengan VITE_
# Akses di code dengan: import.meta.env.VITE_NAMA_VARIABLE
