# .env.example
# Copy file ini menjadi .env lalu isi nilainya.

# Supabase (untuk daftar hadir / buku tamu)
# Ambil dari Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Catatan:
# - Variabel environment di Vite harus dimulai dengan VITE_
# - Akses di code dengan: import.meta.env.VITE_NAMA_VARIABLE
# - Jika VITE_SUPABASE_* kosong, GuestBook fallback ke localStorage.
